print(int(gravity))              # 9

#Integer to String
num_int = 10
print(num_int)                   # 10
num_str = str(num_int)      
print(num_int)                  # '10'

# String to integer or float
num_str = '10.6'
num_float = float(num_str) # Convert string to float
num_int = int(num_float) # Convert float to integer
print("num_float:", num_float)          # 10.6
print("num_int:", num_int)              # 10
print("num_int:", int(float(num_str)))  # 10

